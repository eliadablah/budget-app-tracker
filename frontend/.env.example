# frontend/.env.example
# Copy this to .env.local and fill in your real values (from `terraform output`).
# .env.local is gitignored - never commit real values here.
VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/
VITE_AWS_REGION=us-east-1
# Not a secret - Cognito app client IDs are meant to be public in frontend code.
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
