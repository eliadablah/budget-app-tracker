# .gitignore
# Purpose: keep secrets, Terraform state, and build junk out of Git.
# Why it exists first: anything committed once stays in Git history forever,
# so this file goes in BEFORE the first commit.

# --- Terraform ---
# Local working directory (downloaded providers, cached modules)
.terraform/
# State files can contain secrets in plain text. Remote state (S3) is the source of truth.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Variable files often hold real values. Use defaults or environment variables instead.
*.tfvars
*.tfvars.json
# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is intentionally NOT ignored. Commit it so provider versions stay pinned.

# --- Secrets and credentials (never commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials
.aws/
secrets.*

# --- Build output and dependencies ---
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
*.zip

# --- Editor and OS noise ---
.DS_Store
Thumbs.db
.idea/
